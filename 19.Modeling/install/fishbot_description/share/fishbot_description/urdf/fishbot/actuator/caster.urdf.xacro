<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="caster">
    <xacro:macro name="caster_xacro" params="caster_name xyz">
        <link name="${caster_name}_wheel_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <sphere radius="0.016" />
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
            </visual>

            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <sphere radius="0.016" />
                </geometry>
            </collision>
            <xacro:sphere_inertia m="0.005" r="0.016"/>
        </link>

        <joint name="${caster_name}_wheel_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${caster_name}_wheel_link"/>
            <origin xyz="${xyz}"/>
        </joint>
        
        <gazebo reference="${caster_name}_wheel_link">
            <mu1 value="0.0" />
            <mu2 value="0.0" />
            <kp value="1000000000.0" />
            <kd value="1.0" />
            <material>Gazebo/Yellow</material>
        </gazebo>
    </xacro:macro>
</robot>