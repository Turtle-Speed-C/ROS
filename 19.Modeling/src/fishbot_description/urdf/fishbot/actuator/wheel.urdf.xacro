<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel">
    <xacro:macro name="wheel_xacro" params="wheel_name xyz">
        <link name="${wheel_name}_wheel_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.032" length="0.04"/>
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
            </visual>

            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.032" length="0.04"/>
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="0.02" r="0.032" h="0.04"/>
        </link>

        <!-- 修改关节名称,添加 _joint 后缀 -->
        <joint name="${wheel_name}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${wheel_name}_wheel_link"/>
            <origin xyz="${xyz}"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>

        <gazebo reference="${wheel_name}_wheel_link">
            <mu1 value="100.0" />
            <mu2 value="100.0" />
            <kp value="1000000000.0" />
            <kd value="1.0" />
            <material>Gazebo/Yellow</material>
        </gazebo>
    </xacro:macro>
</robot>